# Mode de données : "local" (démonstration, aucun backend requis) ou "supabase"
VITE_DATA_MODE=local

# Renseigner pour activer le backend réel (projet Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optionnel : URL publique du portail (liens partagés, exports)
VITE_PUBLIC_BASE_URL=http://localhost:5173
